{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt -l:*)",
      "Bash(go run ./cmd/nightbot validate:*)"
    ]
  }
}
