{
  "max_parallel": 1,
  "priority": ["claude-night", "claude-day"],
  "providers": {
    "claude-night": {
      "enabled": true,
      "cli": "claude",
      "models": [
        { "model": "claude-opus-5-5", "effort": "xhigh", "tier": "strong" }
      ],
      "login": "secret",
      "secret": "CLAUDE_CODE_OAUTH_TOKEN",
      "runs_on": "ubuntu-latest",
      "lanes": 1,
      "schedule": { "mode": "window", "start": "01:30", "end": "06:30" },
      "limits": { "five_hour_minutes": 280 },
      "note": "Builds and revisions, in the hours before the JackiOh night bot's on the shared subscription."
    },
    "claude-day": {
      "enabled": true,
      "cli": "claude",
      "models": [
        { "model": "claude-opus-5-5", "effort": "xhigh", "tier": "strong" }
      ],
      "login": "secret",
      "secret": "CLAUDE_CODE_OAUTH_TOKEN",
      "runs_on": "ubuntu-latest",
      "lanes": 1,
      "actions": ["plan", "ask"],
      "schedule": { "mode": "window", "start": "13:00", "end": "23:00" },
      "limits": { "five_hour_minutes": 90 },
      "note": "Plans and questions during the day, so a plan is up for approval before the night's build window."
    }
  }
}
