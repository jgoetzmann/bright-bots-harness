# Bright Bots Harness — example configuration.
#
# Copy to .env (`harness init` does this for you) and edit. Every key below is
# required: there are no defaults in code, so a typo'd key is a startup error
# rather than a silently different budget. The only keys that may be left
# empty are the ones whose comment says so.
#
# Format: KEY=VALUE, one per line. `#` starts a comment. Blank lines ignored.
# Surrounding single or double quotes are stripped. Booleans accept
# true/false/1/0/yes/no, case-insensitive. Relative paths are resolved against
# the directory holding this file.
#
# Sixteen of these keys may also be set in .harness/config.json, which overrides
# this file for exactly those keys and rejects any other: WEEKLY_CAP_USD,
# PER_CALL_CAP_USD, RESERVE_PCT, MAX_CONCURRENT_ITEMS, MAX_REVISE_CYCLES,
# NOTIFY_POLL_HOURS, MAX_SUBISSUES, TRACKING_ISSUE, FORK_REPO, UPSTREAM_REPO,
# TRUST_FILE, and the five usage-governance knobs WEEKLY_USAGE_STOP_PCT,
# SESSION_USAGE_STOP_PCT, OVERRUN_PCT, RUN_WINDOW_START, RUN_WINDOW_END.
# Everything else — every secret, the tier, the store — lives here only.
#
# This file contains no real value and must never contain one.

# Which runner executes model calls. `fake` replays tests/fixtures/runner/*.json
# and spends nothing; `cli` shells out to the `claude` CLI and spends capacity.
BACKEND=fake

# The product repository under test, "owner/name" — what the harness clones, reads and
# names in the package README (`config.repo`). Keep it equal to UPSTREAM_REPO below;
# `load_config` validates the two independently and never compares them.
REPO=Bright-Bots-Initiative/brightboost

# Permission tier. Accepted values are 0 and 2; anything else is a startup error.
#   0 — no authenticated request, no write. Delivery 1 behaviour, unchanged, and
#       what the local `bb` container runs at. A token in this file is refused
#       in code while this is 0.
#   2 — Actions mode. harness/gh.py (and nothing else) sends the token; pushes
#       go to FORK_REPO, PRs are opened upstream, issues are created in SELF_REPO
#       only. Requires STORE_BACKEND=github and a non-empty FORK_REPO.
# Tier 1 is not a mode this build implements.
PERMISSION_TIER=0

# Only issues carrying this label are eligible for triage discovery.
ALLOWLIST_LABEL=harness-ok

# Percentage of the weekly Claude allowance this harness may spend in a week.
WEEKLY_BUDGET_PCT=40

# Percentage the harness may spend in a single `harness run` session.
SESSION_BUDGET_PCT=15

# Percentage of the weekly allocation held back and never spent. Also applied to
# WEEKLY_CAP_USD: the dispatcher starts nothing once spend reaches the cap less this.
RESERVE_PCT=10

# Lowercase weekday name on which the weekly budget period restarts, 00:00 UTC.
WEEKLY_RESET_DAY=monday

# Concurrent disposable clones. MUST be 1 in local mode; above 1 is a startup error.
# Actions-mode concurrency is MAX_CONCURRENT_ITEMS below, one clone per job.
MAX_CONCURRENT_CLONES=1

# Turn ceilings per stage, passed to the runner as --max-turns.
MAX_TURNS_DISCOVER=10
MAX_TURNS_PROPOSE=30
MAX_TURNS_IMPLEMENT=80
MAX_TURNS_PACKAGE=10

# Diagnose-and-fix cycles allowed after a red gate sequence. A repeated failure
# signature stops the loop immediately regardless of this number.
MAX_RETRIES_GATES=2

# Unauthenticated GitHub requests permitted in any trailing hour. Exceeding it
# raises before the request is issued, not after.
GITHUB_API_CEILING_PER_HOUR=50

# Free disk, in GB, below which the harness refuses to clone.
MIN_FREE_DISK_GB=5

# SQLite store holding the queue, budget periods, events, and the HTTP cache.
# Under STORE_BACKEND=github this is per-run scratch only; the queue is GitHub.
DB_PATH=harness.db

# Where disposable clones, transcripts, and built packages live. Never committed.
RUNS_DIR=runs

# Where `harness archive` promotes a finished package. Committed.
PACKAGES_DIR=packages

# Kill switch for a local run. Create this file and every stage boundary refuses
# to proceed (exit 5). Actions mode has a second one: .harness/HALT on main.
HALT_FILE=HALT

# Whether the fullsend implementation path may be used when all five fitness
# conditions hold. False keeps every item on the ordinary single-agent path.
FULLSEND_ENABLED=false

# Classic GitHub PAT on the jgoetzmann-bot machine account, scope
# `public_repo` ONLY — never `workflow`, whose absence is invariant I-15.
# Leave empty here. At PERMISSION_TIER=0 it is refused in code even when
# present; at tier 2 it is read by config.github_token() and used by
# harness/gh.py alone. local/container_env.ps1 strips this line before the
# container starts, so the `bb` container never holds it.
HARNESS_GITHUB_TOKEN=

# Deliberately empty. The harness is subscription-backed, and the CLI runner
# removes this variable from the subprocess environment so that a stray key
# cannot silently move billing to a different pool.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Delivery 2 keys. All required unless the comment says the value may be empty.
# ---------------------------------------------------------------------------

# Hard ceiling, in USD, on accumulated spend per weekly window, as recorded in
# state/ledger.json from each call's total_cost_usd. Must be > 0. Sized so the
# harness's own accounting is sufficient alone (DECISIONS D19), and — since
# Delivery 3 — sized ABOVE a Max 20x week's realistic spend so that the USD
# backstop cannot bind before WEEKLY_USAGE_STOP_PCT does whenever the
# subscription's own utilization signal is present (DECISIONS D31). With no
# signal it is the only weekly control there is, which is why it is still hard.
WEEKLY_CAP_USD=400.00

# Per-call ceiling, in USD, passed to the CLI as --max-budget-usd. Must be > 0.
# Advisory until DECISIONS D19 records that the flag binds on subscription auth.
PER_CALL_CAP_USD=3.00

# Dispatcher slots: how many approved items may start in one window. >= 1.
# Above 1 requires STORE_BACKEND=github (Actions mode); local mode keeps 1.
MAX_CONCURRENT_ITEMS=1

# Revision cycles per delivery PR before the item is labelled harness:needs-human
# and left alone until a trusted /harness fix. >= 0.
MAX_REVISE_CYCLES=3

# The fork the machine account owns, "owner/name" — where work branches are
# pushed. May be empty ONLY at PERMISSION_TIER=0. Required at tier 2.
FORK_REPO=

# The product repository, "owner/name", as the delivery side names it: the base of every
# pull request `deliver` and `revise` open (`config.upstream_repo`) and the repository
# `sync-fork` fast-forwards the fork from. Nothing checks it against REPO — `load_config`
# shape-checks each key on its own — and this one is a `.harness/config.json` knob while
# REPO is not, so an override there can split the two: the package README would name REPO
# and the PR would land on UPSTREAM_REPO. Set both to the same repository.
UPSTREAM_REPO=Bright-Bots-Initiative/brightboost

# GitHub handles whose /harness commands are honoured, one per line, relative to
# this file. CODEOWNERS-protected; the harness cannot write it.
TRUST_FILE=.harness/trust.txt

# Cadence of the feedback sweep, in hours. >= 1. Also the worst-case latency for
# a command left on the product repository (see docs/OPERATIONS.md §9).
NOTIFY_POLL_HOURS=3

# Most sub-issues `decompose` may create from one parent. 1..50.
MAX_SUBISSUES=8

# THIS repository, "owner/name" — where the queue (issues + labels), proposal
# PRs, and any issue the harness creates live. Never the product repository.
SELF_REPO=jgoetzmann/bright-bots-harness

# Number of the pinned tracking issue in SELF_REPO that heartbeat.yml comments
# on weekly. May be empty until it exists; its silence is the alarm.
TRACKING_ISSUE=

# Where the queue lives. `sqlite` = harness.db (local mode, the five-command
# walkthrough). `github` = issues in SELF_REPO (Actions mode). Tier 2 requires
# `github`.
STORE_BACKEND=sqlite

# Subscription token the `claude` CLI needs to authenticate a run without an
# interactive login: the output of `claude setup-token`. Leave empty here; in
# Actions it is a repo secret, and locally it is the one secret that DOES pass
# through the container's credential filter, because the loop needs it.
CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# Delivery 3 keys — usage-aware governance. All required; none may be empty
# except the two run-window keys, which are empty only together (always open).
# The signal these read is the `rate_limit_event` the claude CLI emits on every
# call under --output-format stream-json (DECISIONS D31). No decision DEPENDS on
# it: when it is absent the USD path above governs exactly as in Delivery 2
# (B114). All five may also be set in .harness/config.json.
# ---------------------------------------------------------------------------

# Stop starting work once the subscription's seven-day utilization reaches this
# percentage. 0 < x <= 100. Compared as seven_day.utilization * 100 >= this.
WEEKLY_USAGE_STOP_PCT=90

# Stop starting work once the five-hour (session) utilization reaches this
# percentage. 0 < x <= 100. The tighter of the two stops wins.
SESSION_USAGE_STOP_PCT=70

# Leeway, in weekly utilization percent, granted to a CARRIED item after the
# weekly reset so a half-finished branch can be driven to a delivery PR instead
# of abandoned. 0 <= x < WEEKLY_USAGE_STOP_PCT. Applies to the carried item
# only; every other item still waits for WEEKLY_USAGE_STOP_PCT.
OVERRUN_PCT=10

# The weekly run window, in UTC, as `<weekday> HH:MM` with a lowercase
# three-letter weekday: mon tue wed thu fri sat sun. Outside it no new item
# starts (a carried item may, and `harness run --item N` bypasses the window but
# never the usage stops). The window may wrap past Sunday. Set BOTH to empty to
# keep the window always open. These values open on Monday morning and close at
# this account's weekly reset, Tuesday 20:00 UTC = 13:00 PT (DECISIONS D32).
RUN_WINDOW_START=mon 08:00
RUN_WINDOW_END=tue 20:00
